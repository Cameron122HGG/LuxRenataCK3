# Required controller: select_scope_object
# Picks a holy site for the elevate / demote decisions.

vbox = {
	name = "decision_view_widget_select_holy_site"
	layoutpolicy_horizontal = expanding
	layoutpolicy_vertical = expanding
	ignoreinvisible = yes

	scrollbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		size = { 545 200 }

		blockoverride "scrollbox_content" {
			vbox = {
				margin_top = 10
				datamodel = "[DecisionViewWidgetSelectScopeObject.GetEntries]"
				spacing = 6

				item = {
					button_standard = {
						size = { 450 60 }
						margin = { 10 10 }

						datacontext = "[SelectScopeObjectEntry.GetScopeObject.HolySite]"

						onclick = "[DecisionViewWidgetSelectScopeObject.OnSelect(SelectScopeObjectEntry.Self)]"
						enabled = "[SelectScopeObjectEntry.IsEnabled]"
						down = "[SelectScopeObjectEntry.IsSelected]"
						tooltip = "[SelectScopeObjectEntry.GetTooltip]"

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 10
							margin_left = 10

							coa_title_small = {
								name = "holy_site_coa"
								datacontext = "[HolySite.GetBarony]"

								blockoverride "coa_onclick" {
									onclick = "[OpenGameViewData( 'holy_site', HolySite.Self )]"
								}
								blockoverride "coa_tooltip" {
									tooltip = "HOLY_SITE_LIST_TT"
								}
							}

							vbox = {
								name = "option_info"
								layoutpolicy_vertical = expanding
								margin_bottom = 5

								text_single = {
									name = "holy_site_name"
									text = "[HolySite.GetNameNoTooltip]"
									max_width = 280
									align = left
								}
							}

							expand = {}
						}
					}
				}
			}
		}

		blockoverride "scrollbox_background_fade" {}
	}
}
