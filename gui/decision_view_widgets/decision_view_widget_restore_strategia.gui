# Required controller: decision_option_list_controller
# Copy of decision_view_widget_recover_fallen_dioceses.gui with its own heading (strategiai)

vbox = {
	name = "decision_view_widget_restore_strategia"
	layoutpolicy_horizontal = expanding
	layoutpolicy_vertical = expanding
	ignoreinvisible = yes

	margin_top = 10
	spacing = 10

	text_label_center = {
		text = "LR_CHOOSE_STRATEGIA_BUTTON"
	}

	hbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			blockoverride "scrollbox_content" {
				vbox = {
					datamodel = "[DecisionViewWidgetOptionList.GetEntries]"
					spacing = 6

					item = {
						CommissionArtifactItem = {}
					}
				}
			}

			blockoverride "scrollbox_background_fade" {}
		}
	}
}
