# Lux Renata: the Patron Gods tab of the faith window.
# Built on Elder Kings 2's pattern (one tab button and one widget added to the vanilla window_faith.gui),
# with the contents rebuilt from the old agot_patron_window.gui. Driven by the patron scripted GUIs in
# common/scripted_guis/00_agot_patrons_scripted_gui.txt:
#   religion_has_patron_gods (root = faith)      - does the viewed faith have patron gods? (shows the tab)
#   faith_switch_effect / get_patron_god_list    - build the player's 'patron_gods' list for the viewed faith
#   choose_patron_god_generic (patron_god_name)  - pick a patron (piety cost; only for your own faith)
#   has_this_patron_god (patron_god_name)        - is this the player's current patron?
# Each god is a flag such as patron_god_roman_deity_01, with:
#   <flag>             name (loc)          <flag>_desc     description (loc)
# 1.21: use Scope.GetFlagKey for the raw flag (patron_god_roman_deity_01). GetFlagName returns the flag's
# localized text ("Jupiter"), which broke every lookup and the Choose button (fixed 2026-11-24).
#   <flag>_modifier    character modifier  <flag>_icon     icon (hidden culture innovation, LR_patron_icon_innovations.txt)

types LRPatrons
{
	type LR_faith_patrons_tab = vbox {
		name = "tab_patrons"
		visible = "[FaithWindow.IsActiveTab( 'tab_patrons' )]"
		visible_at_creation = no
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin = { 10 10 }
		spacing = 8

		state = {
			name = _show
			using = Animation_FadeIn_Quick
			on_start = "[GetScriptedGui('faith_switch_effect').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'faith', FaithWindow.GetFaith.MakeScope ).End )]"
			on_start = "[GetScriptedGui('get_patron_god_list').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'faith', FaithWindow.GetFaith.MakeScope ).End )]"
		}

		# The viewed faith changed while the tab is open: rebuild the list (Elder Kings' faith_get_patrons refresh)
		state = {
			name = "LR_patrons_faith_change"
			next = _show
			trigger_when = "[Not( ObjectsEqual( GetPlayer.MakeScope.Var( 'selected_faith' ).Faith, FaithWindow.GetFaith.Self ) )]"
			on_start = "[GetScriptedGui('clear_patron_god_list').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}

		# The viewed faith has no patron gods: go back to Beliefs
		state = {
			name = "LR_patrons_none"
			trigger_when = "[Not( GetScriptedGui('religion_has_patron_gods').IsShown( GuiScope.SetRoot( FaithWindow.GetFaith.MakeScope ).End ) )]"
			on_start = "[FaithWindow.SetActiveTab( 'tab_beliefs' )]"
		}

		# Current patron
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 10 4 }
			spacing = 6

			background = {
				using = Background_Area
			}

			text_single = {
				text = "LR_PATRON_CURRENT"
				default_format = "#low"
			}
			text_single = {
				visible = "[GetPlayer.MakeScope.Var( 'patron_god' ).IsSet]"
				text = "[Localize( GetPlayer.MakeScope.Var( 'patron_god' ).GetFlagKey )]"
				using = Font_Size_Medium
			}
			text_single = {
				visible = "[Not( GetPlayer.MakeScope.Var( 'patron_god' ).IsSet )]"
				text = "LR_PATRON_NONE"
				default_format = "#weak"
			}
			expand = {}
			text_single = {
				visible = "[Not( ObjectsEqual( FaithWindow.GetFaith.Self, GetPlayer.GetFaith.Self ) )]"
				text = "LR_PATRON_OTHER_FAITH"
				default_format = "#weak"
			}
		}

		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			blockoverride "scrollbox_content"
			{
				# Two panels (2026-11-24): the faith's primary pantheon (list patron_gods) and the player's
				# own rite gods (list rite_patron_gods, filled only when viewing your own faith).
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 14

					LR_patron_panel = {
						blockoverride "panel_title" {
							text = "LR_PATRON_FAITH_PANEL"
						}
						blockoverride "panel_subtitle" {
							text = "LR_PATRON_FAITH_PANEL_DESC"
						}
						blockoverride "panel_list" {
							datamodel = "[GetPlayer.MakeScope.GetList( 'patron_gods' )]"
						}
					}

					LR_patron_panel = {
						visible = "[Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'rite_patron_gods' ) ) )]"
						blockoverride "panel_title" {
							text = "LR_PATRON_RITE_PANEL"
						}
						blockoverride "panel_subtitle" {
							text = "LR_PATRON_RITE_PANEL_DESC"
						}
						blockoverride "panel_list" {
							datamodel = "[GetPlayer.MakeScope.GetList( 'rite_patron_gods' )]"
						}
					}
				}
			}
		}
	}

	# A framed panel with a title, a one-line explanation and a list of god cards
	type LR_patron_panel = vbox {
		layoutpolicy_horizontal = expanding
		margin = { 6 8 }
		spacing = 6

		background = {
			using = Background_Area
		}

		text_single = {
			layoutpolicy_horizontal = expanding
			margin = { 6 0 }
			using = Font_Size_Medium
			default_format = "#T"
			block "panel_title" {
				text = ""
			}
		}
		text_single = {
			layoutpolicy_horizontal = expanding
			margin = { 6 0 }
			default_format = "#weak"
			block "panel_subtitle" {
				text = ""
			}
		}
		divider_light = {
			layoutpolicy_horizontal = expanding
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
			block "panel_list" {}

			item = {
				LR_patron_god_entry = {}
			}
		}
	}

	# One god = one card (pattern of Historical_Bloodline.gui, 2026-11-24): the whole card is the button that
	# chooses the god, the current patron's card shows pressed (down), and the lore button opens a taller
	# card with the god's description. The open/closed state is kept per god in the variable system.
	type LR_patron_god_entry = vbox {
		layoutpolicy_horizontal = expanding

		# Short card: icon, name, bonuses
		LR_patron_god_card = {
			visible = "[Not( GetVariableSystem.Exists( Concatenate( 'patron_lore_', Scope.GetFlagKey ) ) )]"
		}

		# Tall card with the lore, toggled by the lore button
		LR_patron_god_card = {
			visible = "[GetVariableSystem.Exists( Concatenate( 'patron_lore_', Scope.GetFlagKey ) )]"

			blockoverride "card_size" {
				size = { 0 230 }
			}
			blockoverride "lore_button" {
				frame = 2
				tooltip = "LR_PATRON_LORE_HIDE_TT"
			}
			blockoverride "lore_visible" {
				visible = yes
			}
		}
	}

	type LR_patron_god_card = button_standard_list {
		layoutpolicy_horizontal = expanding
		datacontext = "[GetModifier( Concatenate( Scope.GetFlagKey, '_modifier' ) )]"
		down = "[EqualTo_string( GetPlayer.MakeScope.Var( 'patron_god' ).GetFlagKey, Scope.GetFlagKey )]"
		# choose_patron_god_generic checks again in its effect (piety, own faith, not already the patron)
		onclick = "[GetScriptedGui('choose_patron_god_generic').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'patron_god_name', MakeScopeFlag( Scope.GetFlagKey ) ).End )]"
		tooltip = "PATRON_GOD_SELECTION_TOOLTIP"

		block "card_size" {
			size = { 0 120 }
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 10 8 }
			spacing = 6

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				icon = {
					size = { 80 80 }
					texture = "[GetCultureInnovationType( Concatenate( Scope.GetFlagKey, '_icon' ) ).GetIcon]"
					using = Mask_Rough_Edges
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

						text_single = {
							text = "[Localize( Scope.GetFlagKey )]"
							using = Font_Size_Medium
							default_format = "#high"
						}
						expand = {}
						text_single = {
							visible = "[EqualTo_string( GetPlayer.MakeScope.Var( 'patron_god' ).GetFlagKey, Scope.GetFlagKey )]"
							text = "LR_PATRON_IS_CURRENT"
							default_format = "#high"
						}
						button_expand = {
							onclick = "[GetVariableSystem.Toggle( Concatenate( 'patron_lore_', Scope.GetFlagKey ) )]"
							block "lore_button" {
								frame = 1
								tooltip = "LR_PATRON_LORE_SHOW_TT"
							}
						}
					}

					divider_light = {
						layoutpolicy_horizontal = expanding
					}

					text_multi = {
						layoutpolicy_horizontal = expanding
						max_width = 460
						autoresize = yes
						text = "[StaticModifier.GetDescWithEffects]"
					}
					expand = {}
				}
			}

			# The lore (description), only on the tall card
			text_multi = {
				block "lore_visible" {
					visible = no
				}
				layoutpolicy_horizontal = expanding
				# Must stay narrower than the room inside the card, or it widens the card past the panel and
				# cuts off "Your patron" and the lore button (seen 2026-11-24 at 620 and still at 560; 480 since the panels add a margin).
				max_width = 480
				autoresize = yes
				margin = { 6 0 }
				text = "[Localize( Concatenate( Scope.GetFlagKey, '_desc' ) )]"
				default_format = "#low"
			}
			expand = {}
		}
	}
}
