# Trait Map Mode - override of the type flowcontainer_additional_mapmodes
# from gui/shared/mapmodes.gui (Lux Renata copy, vanilla 1.21.0). GUI types are registered by the
# first file that declares them and gui/00_* loads before gui/shared/*.
# Identical to the type in LR gui/shared/mapmodes.gui (1.21 plus LR moving de jure counties,
# hegemonies, government and court languages to the main bar) except the LR row (Trait Map and title set map buttons)
# after the epidemics/legends/players/production/markets row. Rebuilt 2026-11-18;
# re-check against vanilla's type on every patch.
types TmmMapModes
{
	type flowcontainer_additional_mapmodes = flowcontainer {

		visible = "[GetVariableSystem.Exists( 'mapmodes_expand' )]"
		visible_at_creation = no

		margin = { 22 10 }
		alwaystransparent = no
		filter_mouse = all

		state = {
			name = _mouse_hierarchy_leave
			on_finish = "[GetVariableSystem.Toggle( 'mapmodes_expand' )]"
		}

		state = {
			name = _show
			using = Animation_FadeIn_Quick
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Standard
		}

		flowcontainer = {
			direction = vertical
			margin = { 10 10 }
			margin_top = 5
			ignoreinvisible = yes

			background = {
				using = Background_Area_Dark
				color = { 0.15 0.15 0.15 0.75 }
			}

			text_single = {
				parentanchor = hcenter
				text = "ADDITIONAL_MAPMODES"
				default_format = "#medium"
				margin_bottom = 5
				max_width = 130
			}

			block "mapmodes_insert_before"
			{

			}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				parentanchor = hcenter
				spacing = 4	

				flowcontainer = {
					ignoreinvisible = yes
					parentanchor = hcenter
					
					icon_button_mapmode = {
						name = "economy_buildings"
						parentanchor = vcenter
						size = { 32 32 }
						
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'economy_buildings' )]"
						}
						
						blockoverride "mm_icon"
						{
							size = { 20 20 }
						}
						
						blockoverride "mm_button"
						{
							shortcut = "map_mode_economy_buildings"
						}
					}
					
					icon_button_mapmode = {
						name = "county_prosperity"
						parentanchor = vcenter
						size = { 32 32 }
						
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'county_prosperity' )]"
						}
						
						blockoverride "mm_icon"
						{
							size = { 20 20 }
						}
						
						blockoverride "mm_button"
						{
							shortcut = "map_mode_county_prosperity"
						}
					}
					
					icon_button_mapmode = {
						name = "county_control"
						parentanchor = vcenter
						size = { 32 32 }
						
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'county_control' )]"
						}
						
						blockoverride "mm_icon"
						{
							size = { 22 22 }
						}
						
						blockoverride "mm_button"
						{
							shortcut = "map_mode_county_control"
						}
					}
					
					icon_button_mapmode = {
						name = "popular_opinion"
						parentanchor = vcenter
						size = { 32 32 }
						
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'popular_opinion_map' )]"
						}
						
						blockoverride "mm_icon"
						{
							texture = "gfx/interface/icons/flat_icons/map_modes/popular_opinion.dds"
							size = { 20 20 }
						}
						
						blockoverride "mm_button"
						{
							shortcut = "map_mode_popular_opinion"
						}
					}
					
					icon_button_mapmode = {
						name = "county_fertility"
						parentanchor = vcenter
						size = { 32 32 }
						visible = "[HasDlcFeature( 'khans_of_the_steppe' )]"
						
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'migration_counties' )]"
						}
						
						blockoverride "mm_button"
						{
							shortcut = "map_mode_migration_counties"
						}
					}
				}

				divider_light = {
					min_width = 100
					parentanchor = hcenter
				}
				
				flowcontainer = {
					ignoreinvisible = yes
					parentanchor = hcenter
					
					icon_button_mapmode = {
						name = "terrain"
						parentanchor = vcenter
						size = { 32 32 }
						
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'terrain' )]"
						}
						
						blockoverride "mm_icon"
						{
							texture = "gfx/interface/icons/flat_icons/map_modes/terrain.dds"
							size = { 20 20 }
						}
						
						blockoverride "mm_button"
						{
							shortcut = "map_mode_terrain"
						}
					}
					
					icon_button_mapmode = {
						name = "simple_terrain"
						parentanchor = vcenter
						size = { 32 32 }
						
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'simple_terrain' )]"
						}
						
						blockoverride "mm_icon"
						{
							texture = "[MapMode.GetIcon]"
							size = { 20 20 }
						}
						
						blockoverride "mm_button"
						{
							shortcut = "map_mode_simple_terrain"
						}
					}
					
					icon_button_mapmode = {
						name = "settlement_size"
						parentanchor = vcenter
						size = { 32 32 }
						
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'settlement_size' )]"
						}
						
						blockoverride "mm_icon"
						{
							texture = "gfx/interface/icons/flat_icons/map_modes/settlement_size.dds"
							size = { 20 20 }
						}
						
						blockoverride "mm_button"
						{
							shortcut = "map_mode_settlement_size"
						}
					}
					
					icon_button_mapmode = {
						name = "confederations"
						parentanchor = vcenter
						size = { 32 32 }
						
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'confederations' )]"
						}
						
						blockoverride "mm_icon"
						{
							texture = "gfx/interface/icons/flat_icons/map_modes/confederations.dds"
							size = { 20 20 }
						}
						
						blockoverride "mm_button"
						{
							shortcut = "map_mode_confederations"
						}
					}
				}

				divider_light = {
					min_width = 100
					parentanchor = hcenter
				}
				
				flowcontainer = {
					ignoreinvisible = yes
					parentanchor = hcenter
					
					icon_button_mapmode = {
						name = "diplomatic_relations"
						parentanchor = vcenter
						size = { 32 32 }
						
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'diplomatic_relations' )]"
						}
						
						blockoverride "mm_icon"
						{
							texture = "[MapMode.GetIcon]"
							size = { 20 20 }
						}
						
						blockoverride "mm_button"
						{
							shortcut = "map_mode_diplomatic_relations"
						}
					}
					
					icon_button_mapmode_landless_rulers = {
						visible = "[And3( HasDlcFeature( 'landless_playable' ), CanChangeMapMode, Not(GetPlayer.GetGovernment.HasGovernmentFlag( 'government_is_merchant' ) ) )]"
						parentanchor = vcenter
						size = { 32 32 }
					}
				}
				
				divider_light = {
					min_width = 100
					parentanchor = hcenter
				}
				
				flowcontainer = {
					ignoreinvisible = yes
					parentanchor = hcenter
					
					icon_button_mapmode = {
						name = "map_mode_epidemics_button"
						parentanchor = vcenter
						size = { 32 32 }
						
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'epidemics' )]"
						}
						
						blockoverride "mm_button"
						{
							shortcut = "map_mode_epidemics"
						}
					}
					
					icon_button_mapmode = {
						name = "map_mode_legends_button"
						visible = "[And( HasDlcFeature( 'legends' ), CanChangeMapMode )]"
						parentanchor = vcenter
						size = { 32 32 }
						
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'legends' )]"
						}
						
						blockoverride "mm_button"
						{
							shortcut = "map_mode_legends"
						}
					}
					
					icon_button_mapmode = {
						name = "players"
						visible = "[And( Or(GameHasMultiplePlayers, InDebugMode), CanChangeMapMode)]"
						parentanchor = vcenter
						size = { 32 32 }
						
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'players' )]"
						}
						
						blockoverride "mm_icon"
						{
							size = { 26 26 }
						}
						
						blockoverride "mm_button"
						{
							shortcut = "map_mode_players"
						}
					}
					
					icon_button_mapmode_top_production = {
						parentanchor = vcenter
						visible = "[Not(GetPlayer.GetGovernment.HasGovernmentFlag( 'government_is_merchant' ))]"
						size = { 32 32 }
					}

					icon_button_mapmode_markets = {
						parentanchor = vcenter
						visible = "[Not(GetPlayer.GetGovernment.HasGovernmentFlag( 'government_is_merchant' ))]"
						size = { 32 32 }
					}
				}

				divider_light = {
					min_width = 100
					parentanchor = hcenter
				}

				# LR: Trait Map and title set map buttons in their own row
				flowcontainer = {
					ignoreinvisible = yes
					parentanchor = hcenter

					# TMM start - Trait map: opens the tmm_trait_map situation view
					widget = {
						name = "tmm_map_mode_button"
						parentanchor = vcenter
						size = { 32 32 }
						datacontext = "[GetSituation( 'tmm_trait_map' )]"
						visible = "[CanChangeMapMode]"

						icon = {
							size = { 100% 100% }
							texture = "gfx/interface/component_masks/mask_circle.dds"
							visible = "[And( Situation.IsValid, IsMapMode( 'situation' ) )]"

							glow = {
								color = { 0.93 0.65 0.45 1.0 }
								glow_radius = 6

								glow_generation_rules = {
									glow_alpha_mask = 0
									glow_blur_passes = 15
									glow_texture_downscale = 5.5f
									glow_ignore_inside_pixels = yes
								}
							}

							using = Animation_Glow_Pulse
						}

						button_round = {
							visible = "[Situation.IsValid]"
							size = { 100% 100% }
							using = tooltip_nw
							onclick = "[ToggleGameViewData( Situation.GetWindowName, Situation.GetID )]"
							tooltip = "TMM_MAP_MODE_BUTTON_TT"

							icon = {
								parentanchor = center
								size = { 24 24 }
								alwaystransparent = yes
								texture = "gfx/interface/icons/message_feed/trait.dds"
							}
						}

						button_round = {
							visible = "[Not( Situation.IsValid )]"
							size = { 100% 100% }
							using = tooltip_nw
							onclick = "[GetScriptedGui( 'tmm_start_situation' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'tmm_start_situation' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							tooltip = "TMM_MAP_MODE_BUTTON_START_TT"

							icon = {
								parentanchor = center
								size = { 24 24 }
								alwaystransparent = yes
								alpha = 0.5
								texture = "gfx/interface/icons/message_feed/trait.dds"
							}
						}
					}
					# TMM end
					# LR title set map start - opens the LR_title_set_map situation view (same build as the Trait Map button)
					widget = {
						name = "LR_tsm_map_mode_button"
						parentanchor = vcenter
						size = { 32 32 }
						datacontext = "[GetSituation( 'LR_title_set_map' )]"
						visible = "[CanChangeMapMode]"

						icon = {
							size = { 100% 100% }
							texture = "gfx/interface/component_masks/mask_circle.dds"
							visible = "[And( Situation.IsValid, IsMapMode( 'situation' ) )]"

							glow = {
								color = { 0.93 0.65 0.45 1.0 }
								glow_radius = 6

								glow_generation_rules = {
									glow_alpha_mask = 0
									glow_blur_passes = 15
									glow_texture_downscale = 5.5f
									glow_ignore_inside_pixels = yes
								}
							}

							using = Animation_Glow_Pulse
						}

						button_round = {
							visible = "[Situation.IsValid]"
							size = { 100% 100% }
							using = tooltip_nw
							# LR 2026-11-22: repaint first if the map is stale (it no longer paints in the background)
							onclick = "[GetScriptedGui( 'LR_tsm_open' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							onclick = "[ToggleGameViewData( Situation.GetWindowName, Situation.GetID )]"
							tooltip = "LR_TSM_MAP_MODE_BUTTON_TT"

							icon = {
								parentanchor = center
								size = { 24 24 }
								alwaystransparent = yes
								texture = "gfx/interface/icons/message_feed/titles.dds"
							}
						}

						button_round = {
							visible = "[Not( Situation.IsValid )]"
							size = { 100% 100% }
							using = tooltip_nw
							onclick = "[GetScriptedGui( 'LR_tsm_start_situation' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_start_situation' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							tooltip = "LR_TSM_MAP_MODE_BUTTON_START_TT"

							icon = {
								parentanchor = center
								size = { 24 24 }
								alwaystransparent = yes
								alpha = 0.5
								texture = "gfx/interface/icons/message_feed/titles.dds"
							}
						}
					}
					# LR title set map end
				}

				divider_light = {
					min_width = 100
					parentanchor = hcenter
				}
				
				flowcontainer = {
					ignoreinvisible = yes
					parentanchor = hcenter
					visible = "[GetPlayer.GetGovernment.HasGovernmentFlag( 'government_is_merchant' )]"

					icon_button_mapmode_dejure_duchies = {
						size = { 32 32 }
					}

					icon_button_mapmode_dejure_kingdoms = {
						size = { 32 32 }
					}

					icon_button_mapmode_dejure_empires = {
						size = { 32 32 }
					}

					icon_button_mapmode_dejure_hegemonies = {
						size = { 32 32 }
					}
				}
			}

			text_single = {
				parentanchor = hcenter
				text = "ADDITIONAL_MAP_SETTINGS"
				default_format = "#medium"
				margin_bottom = 5
				max_width = 130
			}
						
			flowcontainer = {
				direction = vertical
				margin = { 5 5 }
				ignoreinvisible = yes
				parentanchor = hcenter
				
				background = {
					using = Background_Area_Dark
				}
				
				min_width = 159
				
				button_checkbox_label = {
					onclick = "[ToggleShowEpidemicMapGraphics]"
					tooltip = "SETTING_SHOW_EPIDEMIC_MAP_GRAPHICS_TOOLTIP"
					
					state = {
						name = _show
						using = Animation_FadeIn_Standard
					}
					
					state = {
						name = _hide
						using = Animation_FadeOut_Standard
					}
					
					blockoverride "checkbox"
					{
						checked = "[ShowEpidemicMapGraphics]"
						size = { 20 20 }
					}
					
					blockoverride "text"
					{
						text = "SETTING_SHOW_EPIDEMIC_MAP_GRAPHICS"
						min_width = 120
						max_width = 125
						fontsize = 14
						max_height = 18
					}
				}
				
				button_checkbox_label = {
					onclick = "[ToggleShowLegendMapGraphics]"
					tooltip = "SETTING_SHOW_LEGEND_MAP_GRAPHICS_TOOLTIP"
					visible = "[HasDlcFeature( 'legends' )]"
					
					state = {
						name = _show
						using = Animation_FadeIn_Standard
					}
					
					state = {
						name = _hide
						using = Animation_FadeOut_Standard
					}
					
					blockoverride "checkbox"
					{
						checked = "[ShowLegendMapGraphics]"
						size = { 20 20 }
					}
					
					blockoverride "text"
					{
						text = "SETTING_SHOW_LEGEND_MAP_GRAPHICS"
						min_width = 120
						max_width = 125
						fontsize = 14
						max_height = 18
					}
				}
				
				button_checkbox_label = {
					visible = "[GetPlayer.CanRaid]"
					onclick = "[ToggleShowDetailedRaidMapIcons]"
					tooltip = "SETTING_SHOW_DETAILED_RAID_MAP_ICON_TOOLTIP"
					
					state = {
						name = _show
						using = Animation_FadeIn_Standard
					}
					
					state = {
						name = _hide
						using = Animation_FadeOut_Standard
					}
					
					blockoverride "checkbox"
					{
						checked = "[ShowDetailedRaidMapIcons]"
						size = { 20 20 }
					}
					
					blockoverride "text"
					{
						text = "SETTING_SHOW_DETAILED_RAID_MAP_ICON"
						min_width = 120
						max_width = 125
						fontsize = 14
						max_height = 18
					}
				}
				
				button_checkbox_label = {
					visible = "[GetPlayer.HasBarterGoods]"
					onclick = "[ToggleShowDetailedBarterMapIcons]"
					tooltip = "SETTING_SHOW_DETAILED_BARTER_MAP_ICON_TOOLTIP"
					
					state = {
						name = _show
						using = Animation_FadeIn_Standard
					}
					
					state = {
						name = _hide
						using = Animation_FadeOut_Standard
					}
					
					blockoverride "checkbox"
					{
						checked = "[ShowDetailedBarterMapIcons]"
						size = { 20 20 }
					}
					
					blockoverride "text"
					{
						text = "SETTING_SHOW_DETAILED_BARTER_MAP_ICON"
						min_width = 120
						max_width = 125
						fontsize = 14
						max_height = 18
					}
				}
			}
		}
	}
}
