######################################################
############### TITLE SET MAP WINDOW #################
######################################################
# Situation view of LR_title_set_map (gui_window_name), built like window_tmm_trait_map.gui.
# Opening it switches the map to the 'situation' map mode, which paints the sub-regions of this situation.
# The view buttons switch between the Land view (the set each county's de jure titles belong to) and the
# Rule view (who rules each county's set titles: natives in the set colour, outsiders in red).

window = {
	name = "window_LR_title_set_map"
	widgetid = "window_LR_title_set_map"
	datacontext = "[SituationWindow.GetSituation]"
	datacontext = "[GetVariableSystem]"
	datacontext = "[GetPlayer]"
	parentanchor = top|right
	layer = windows_layer
	movable = no
	allow_outside = yes

	using = Window_Size_MainTab

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab
		on_start = "[SetMapMode( 'situation' )]"
		on_start = "[SituationWindow.AccessParticipantCharacterList.SetSelectedParticipantGroup( Situation.GetTopParticipantGroupByKey( 'LR_tsm_native' ) )]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
		on_start = "[SetMapMode( 'realms' )]"
	}

	margin_widget = {
		size = { 100% 100% }
		margin = { 0 26 }
		margin_right = 13

		widget = {
			size = { 100% 100% }

			vbox = {
				using = Window_Margins

				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				spacing = 8

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text"
					{
						text = "[Situation.GetNameNoTooltip]"
					}

					blockoverride "button_back"
					{
						onclick = "[OpenGameView( 'situations' )]"
					}

					blockoverride "button_close"
					{
						onclick = "[SituationWindow.Close]"
					}
				}

				### View choice and set previews ###
				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 15 12 }
					spacing = 8

					background = {
						using = Background_Area
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8

						text_single = {
							text = "LR_TSM_VIEW"
							align = nobaseline
							minimumsize = { 90 0 }
						}

						button_LR_tsm_view = {
							text = "LR_TSM_VIEW_LAND"
							tooltip = "LR_TSM_VIEW_LAND_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_view_land' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_view_land' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this becomes the current choice (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_view_land' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						button_LR_tsm_view = {
							text = "LR_TSM_VIEW_RULE"
							tooltip = "LR_TSM_VIEW_RULE_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_view_rule' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_view_rule' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this becomes the current choice (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_view_rule' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						expand = {}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8

						text_single = {
							text = "LR_TSM_PREVIEW"
							align = nobaseline
							minimumsize = { 90 0 }
						}

						button_LR_tsm_view = {
							text = "LR_TSM_SET_HELLENISTIC"
							tooltip = "LR_TSM_SET_HELLENISTIC_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_preview_hellenistic' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_preview_hellenistic' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this becomes the current choice (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_preview_hellenistic' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						button_LR_tsm_view = {
							text = "LR_TSM_SET_ROMAN"
							tooltip = "LR_TSM_SET_ROMAN_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_preview_roman' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_preview_roman' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this becomes the current choice (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_preview_roman' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						button_LR_tsm_view = {
							text = "LR_TSM_SET_THEMES"
							tooltip = "LR_TSM_SET_THEMES_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_preview_themes' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_preview_themes' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this becomes the current choice (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_preview_themes' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						expand = {}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8

						text_single = {
							text = ""
							align = nobaseline
							minimumsize = { 90 0 }
						}

						button_LR_tsm_view = {
							text = "LR_TSM_SET_PERSIAN"
							tooltip = "LR_TSM_SET_PERSIAN_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_preview_persian' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_preview_persian' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this becomes the current choice (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_preview_persian' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						button_LR_tsm_view = {
							text = "LR_TSM_SET_HEBREW"
							tooltip = "LR_TSM_SET_HEBREW_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_preview_hebrew' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_preview_hebrew' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this becomes the current choice (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_preview_hebrew' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						button_LR_tsm_view = {
							text = "LR_TSM_SET_WARLORD"
							tooltip = "LR_TSM_SET_WARLORD_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_preview_warlord' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_preview_warlord' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this becomes the current choice (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_preview_warlord' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						expand = {}
					}

					# Brythonic (Celtic) and Galatian sets, added 2026-11-06
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8

						text_single = {
							text = ""
							align = nobaseline
							minimumsize = { 90 0 }
						}

						button_LR_tsm_view = {
							text = "LR_TSM_SET_BRYTHONIC"
							tooltip = "LR_TSM_SET_BRYTHONIC_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_preview_brythonic' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_preview_brythonic' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this becomes the current choice (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_preview_brythonic' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						button_LR_tsm_view = {
							text = "LR_TSM_SET_GALATIAN"
							tooltip = "LR_TSM_SET_GALATIAN_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_preview_galatian' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_preview_galatian' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this becomes the current choice (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_preview_galatian' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						expand = {}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						visible = "[GetScriptedGui( 'LR_tsm_is_preview' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						spacing = 8

						text_single = {
							text = "LR_TSM_TIER"
							align = nobaseline
							minimumsize = { 90 0 }
						}

						button_LR_tsm_view = {
							text = "LR_TSM_TIER_DUCHY"
							tooltip = "LR_TSM_TIER_DUCHY_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_preview_tier_duchy' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_preview_tier_duchy' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this becomes the current choice (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_preview_tier_duchy' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						button_LR_tsm_view = {
							text = "LR_TSM_TIER_KINGDOM"
							tooltip = "LR_TSM_TIER_KINGDOM_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_preview_tier_kingdom' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_preview_tier_kingdom' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this becomes the current choice (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_preview_tier_kingdom' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						button_LR_tsm_view = {
							text = "LR_TSM_TIER_EMPIRE"
							tooltip = "LR_TSM_TIER_EMPIRE_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_preview_tier_empire' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_preview_tier_empire' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this becomes the current choice (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_preview_tier_empire' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						# Hegemony tier, added 2026-11-06
						button_LR_tsm_view = {
							text = "LR_TSM_TIER_HEGEMONY"
							tooltip = "LR_TSM_TIER_HEGEMONY_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_preview_tier_hegemony' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_preview_tier_hegemony' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this becomes the current choice (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_preview_tier_hegemony' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						expand = {}
					}

					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 500
						text = "LR_TSM_DESC_LAND"
						default_format = "#weak"
						visible = "[GetScriptedGui( 'LR_tsm_is_land' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					}

					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 500
						text = "LR_TSM_DESC_RULE"
						default_format = "#weak"
						visible = "[GetScriptedGui( 'LR_tsm_is_rule' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					}

					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 500
						text = "LR_TSM_DESC_PREVIEW"
						default_format = "#weak"
						visible = "[GetScriptedGui( 'LR_tsm_is_preview' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					}

				}

				### Legend ###
				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 15 10 }
					spacing = 6

					background = {
						using = Background_Area
					}

					hbox_LR_tsm_legend_row = {
						visible = "[Not( GetScriptedGui( 'LR_tsm_is_preview' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
						blockoverride "swatch_color" { color = { 0.18 0.41 0.8 1 } }
						blockoverride "group_name" { text = "LR_title_set_map_sub_region_LR_tsm_hellenistic" }
						blockoverride "count" { text = "LR_TSM_COUNT_HELLENISTIC" }
					}

					hbox_LR_tsm_legend_row = {
						visible = "[Not( GetScriptedGui( 'LR_tsm_is_preview' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
						blockoverride "swatch_color" { color = { 0.53 0.16 0.51 1 } }
						blockoverride "group_name" { text = "LR_title_set_map_sub_region_LR_tsm_roman" }
						blockoverride "count" { text = "LR_TSM_COUNT_ROMAN" }
					}

					hbox_LR_tsm_legend_row = {
						visible = "[Not( GetScriptedGui( 'LR_tsm_is_preview' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
						blockoverride "swatch_color" { color = { 0.88 0.69 0.18 1 } }
						blockoverride "group_name" { text = "LR_title_set_map_sub_region_LR_tsm_themes" }
						blockoverride "count" { text = "LR_TSM_COUNT_THEMES" }
					}

					hbox_LR_tsm_legend_row = {
						visible = "[Not( GetScriptedGui( 'LR_tsm_is_preview' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
						blockoverride "swatch_color" { color = { 0.16 0.57 0.29 1 } }
						blockoverride "group_name" { text = "LR_title_set_map_sub_region_LR_tsm_persian" }
						blockoverride "count" { text = "LR_TSM_COUNT_PERSIAN" }
					}

					hbox_LR_tsm_legend_row = {
						visible = "[Not( GetScriptedGui( 'LR_tsm_is_preview' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
						blockoverride "swatch_color" { color = { 0.31 0.76 0.82 1 } }
						blockoverride "group_name" { text = "LR_title_set_map_sub_region_LR_tsm_hebrew" }
						blockoverride "count" { text = "LR_TSM_COUNT_HEBREW" }
					}

					hbox_LR_tsm_legend_row = {
						visible = "[Not( GetScriptedGui( 'LR_tsm_is_preview' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
						blockoverride "swatch_color" { color = { 0.59 0.78 0.24 1 } }
						blockoverride "group_name" { text = "LR_title_set_map_sub_region_LR_tsm_brythonic" }
						blockoverride "count" { text = "LR_TSM_COUNT_BRYTHONIC" }
					}

					hbox_LR_tsm_legend_row = {
						visible = "[Not( GetScriptedGui( 'LR_tsm_is_preview' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
						blockoverride "swatch_color" { color = { 0.84 0.39 0.59 1 } }
						blockoverride "group_name" { text = "LR_title_set_map_sub_region_LR_tsm_galatian" }
						blockoverride "count" { text = "LR_TSM_COUNT_GALATIAN" }
					}

					hbox_LR_tsm_legend_row = {
						visible = "[GetScriptedGui( 'LR_tsm_is_rule' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						blockoverride "swatch_color" { color = { 0.82 0.1 0.14 1 } }
						blockoverride "group_name" { text = "LR_title_set_map_sub_region_LR_tsm_foreign" }
						blockoverride "count" { text = "LR_TSM_COUNT_FOREIGN" }
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						visible = "[GetScriptedGui( 'LR_tsm_is_preview' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						spacing = 10

						hbox = {
							spacing = 2
							icon = { size = { 10 22 } texture = "gfx/interface/colors/white.dds" color = { 0.9 0.47 0.2 1 } }
							icon = { size = { 10 22 } texture = "gfx/interface/colors/white.dds" color = { 0.27 0.51 0.78 1 } }
							icon = { size = { 10 22 } texture = "gfx/interface/colors/white.dds" color = { 0.47 0.71 0.31 1 } }
							icon = { size = { 10 22 } texture = "gfx/interface/colors/white.dds" color = { 0.78 0.27 0.55 1 } }
						}

						text_single = {
							text = "LR_TSM_PREVIEW_LEGEND"
							align = nobaseline
						}

						expand = {}

						text_single = {
							text = "LR_TSM_PREVIEW_COUNT"
							align = nobaseline
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 10

						icon = {
							size = { 22 22 }
							texture = "gfx/interface/colors/white.dds"
							color = { 0.5 0.5 0.5 1 }
						}

						text_single = {
							text = "LR_TSM_LEGEND_OTHERS"
							default_format = "#weak"
							align = nobaseline
						}

						expand = {}
					}
				}

				### Title list of the preview ###
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					visible = "[GetScriptedGui( 'LR_tsm_is_preview' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					margin = { 15 10 }
					spacing = 6

					background = {
						using = Background_Area
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "LR_TSM_PREVIEW_LIST"
						align = nobaseline
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						min_height = 160

						blockoverride "scrollbox_content"
						{
							vbox = {
								layoutpolicy_horizontal = expanding
								datamodel = "[Situation.MakeScope.GetList( 'LR_tsm_preview_list' )]"

								item = {
									hbox_LR_tsm_title_row = {
										datacontext = "[Scope.Title]"
									}
								}
							}
						}
					}
				}

				### Map modes & participants ###
				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 15 10 }
					spacing = 10

					background = {
						using = Background_Area
					}

					text_single = {
						text = "TMM_MAP_MODES"
						align = nobaseline
					}

					icon_button_mapmode = {
						size = { 36 36 }
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'situation' )]"
						}
					}

					icon_button_mapmode = {
						size = { 36 36 }
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'realms' )]"
						}
					}

					expand = {}

					button_standard_small = {
						onclick = "[SituationWindow.AccessParticipantCharacterList.Toggle]"
						text = "LR_TSM_VIEW_PARTICIPANTS"
					}
				}

				expand = {}
			}
		}
	}

	window_situation_participant_groups = {
		datacontext = "[SituationWindow.AccessParticipantCharacterList]"
		datacontext = "[SituationParticipantCharacterList.AccessCharacterList]"
		visible = "[SituationParticipantCharacterList.IsVisible]"

		datacontext = "[SituationWindow.GetSelectedSubRegion]"
		blockoverride "header_text"
		{
			text = "[SituationWindow.GetParticipationWindowHeader]"
		}
	}
}

types LRTitleSetMap
{
	# One legend line: map colour, name, number of counties (variables set by LR_tsm_refresh_effect)
	type hbox_LR_tsm_legend_row = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 10

		icon = {
			size = { 22 22 }
			texture = "gfx/interface/colors/white.dds"
			block "swatch_color" {}
		}

		text_single = {
			block "group_name" {}
			align = nobaseline
		}

		expand = {}

		text_single = {
			block "count" {}
			align = nobaseline
		}
	}

	# One title of a preview: map colour (title variable LR_tsm_pcol), coat of arms and name. The name and the coat of
	# arms give the title's usual tooltip; clicking the coat of arms opens the title.
	type hbox_LR_tsm_title_row = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 8
		margin = { 2 1 }

		widget = {
			size = { 14 22 }
			# exactly one swatch is visible
			hbox = {
									icon = {
										visible = "[EqualTo_CFixedPoint( Title.MakeScope.Var( 'LR_tsm_pcol' ).GetValue, '(CFixedPoint)1' )]"
										size = { 14 22 }
										texture = "gfx/interface/colors/white.dds"
										color = { 0.90 0.47 0.20 1 }
									}
									icon = {
										visible = "[EqualTo_CFixedPoint( Title.MakeScope.Var( 'LR_tsm_pcol' ).GetValue, '(CFixedPoint)2' )]"
										size = { 14 22 }
										texture = "gfx/interface/colors/white.dds"
										color = { 0.27 0.51 0.78 1 }
									}
									icon = {
										visible = "[EqualTo_CFixedPoint( Title.MakeScope.Var( 'LR_tsm_pcol' ).GetValue, '(CFixedPoint)3' )]"
										size = { 14 22 }
										texture = "gfx/interface/colors/white.dds"
										color = { 0.47 0.71 0.31 1 }
									}
									icon = {
										visible = "[EqualTo_CFixedPoint( Title.MakeScope.Var( 'LR_tsm_pcol' ).GetValue, '(CFixedPoint)4' )]"
										size = { 14 22 }
										texture = "gfx/interface/colors/white.dds"
										color = { 0.78 0.27 0.55 1 }
									}
									icon = {
										visible = "[EqualTo_CFixedPoint( Title.MakeScope.Var( 'LR_tsm_pcol' ).GetValue, '(CFixedPoint)5' )]"
										size = { 14 22 }
										texture = "gfx/interface/colors/white.dds"
										color = { 0.94 0.80 0.27 1 }
									}
									icon = {
										visible = "[EqualTo_CFixedPoint( Title.MakeScope.Var( 'LR_tsm_pcol' ).GetValue, '(CFixedPoint)6' )]"
										size = { 14 22 }
										texture = "gfx/interface/colors/white.dds"
										color = { 0.35 0.75 0.75 1 }
									}
									icon = {
										visible = "[EqualTo_CFixedPoint( Title.MakeScope.Var( 'LR_tsm_pcol' ).GetValue, '(CFixedPoint)7' )]"
										size = { 14 22 }
										texture = "gfx/interface/colors/white.dds"
										color = { 0.59 0.39 0.78 1 }
									}
									icon = {
										visible = "[EqualTo_CFixedPoint( Title.MakeScope.Var( 'LR_tsm_pcol' ).GetValue, '(CFixedPoint)8' )]"
										size = { 14 22 }
										texture = "gfx/interface/colors/white.dds"
										color = { 0.73 0.55 0.37 1 }
									}
			}
		}

		coa_title_tiny_crown = {}

		text_single = {
			text = "[Title.GetName]"
			align = nobaseline
			max_width = 380
			fontsize_min = 12
		}

		expand = {}
	}

	# A view button: disabled while it is the current view
	type button_LR_tsm_view = button_standard_small {
		size = { 140 30 }
		using = tooltip_ne
	}
}
