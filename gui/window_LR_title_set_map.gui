######################################################
############### TITLE SET MAP WINDOW #################
######################################################
# Situation view of LR_title_set_map (gui_window_name), built like window_tmm_trait_map.gui.
# Opening it switches the map to the 'situation' map mode, which paints the sub-regions of this situation.
# The view buttons switch between the Land view (the set each county's de jure titles belong to) and the
# Rule view (who rules each county's set titles: natives in the set colour, outsiders in red).

window = {
	name = "window_LR_title_set_map"
	widgetid = "window_LR_title_set_map"
	datacontext = "[SituationWindow.GetSituation]"
	datacontext = "[GetVariableSystem]"
	datacontext = "[GetPlayer]"
	parentanchor = top|right
	layer = windows_layer
	movable = no
	allow_outside = yes

	using = Window_Size_MainTab

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab
		on_start = "[SetMapMode( 'situation' )]"
		on_start = "[SituationWindow.AccessParticipantCharacterList.SetSelectedParticipantGroup( Situation.GetTopParticipantGroupByKey( 'LR_tsm_native' ) )]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
		on_start = "[SetMapMode( 'realms' )]"
	}

	margin_widget = {
		size = { 100% 100% }
		margin = { 0 26 }
		margin_right = 13

		widget = {
			size = { 100% 100% }

			vbox = {
				using = Window_Margins

				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				spacing = 8

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text"
					{
						text = "[Situation.GetNameNoTooltip]"
					}

					blockoverride "button_back"
					{
						onclick = "[OpenGameView( 'situations' )]"
					}

					blockoverride "button_close"
					{
						onclick = "[SituationWindow.Close]"
					}
				}

				### View choice ###
				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 15 12 }
					spacing = 10

					background = {
						using = Background_Area
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 10

						text_single = {
							text = "LR_TSM_VIEW"
							align = nobaseline
						}

						button_LR_tsm_view = {
							text = "LR_TSM_VIEW_LAND"
							tooltip = "LR_TSM_VIEW_LAND_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_view_land' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_view_land' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							# Repaint once this view becomes the current one (see button_tmm_trait)
							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_view_land' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						button_LR_tsm_view = {
							text = "LR_TSM_VIEW_RULE"
							tooltip = "LR_TSM_VIEW_RULE_TT"
							onclick = "[GetScriptedGui( 'LR_tsm_view_rule' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'LR_tsm_view_rule' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

							state = {
								name = LR_tsm_refresh
								trigger_when = "[Not( GetScriptedGui( 'LR_tsm_view_rule' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								on_start = "[SetMapMode( 'realms' )]"
								duration = 0.05
								next = LR_tsm_refresh_2
							}
							state = {
								name = LR_tsm_refresh_2
								on_start = "[SetMapMode( 'situation' )]"
							}
						}

						expand = {}
					}

					# The land view is current while the rule button is still valid
					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 500
						text = "LR_TSM_DESC_LAND"
						default_format = "#weak"
						visible = "[GetScriptedGui( 'LR_tsm_view_rule' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					}

					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 500
						text = "LR_TSM_DESC_RULE"
						default_format = "#weak"
						visible = "[Not( GetScriptedGui( 'LR_tsm_view_rule' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					}
				}

				### Legend ###
				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 15 10 }
					spacing = 6

					background = {
						using = Background_Area
					}

					hbox_LR_tsm_legend_row = {
						blockoverride "swatch_color" { color = { 0.18 0.41 0.8 1 } }
						blockoverride "group_name" { text = "LR_title_set_map_sub_region_LR_tsm_hellenistic" }
						blockoverride "count" { text = "LR_TSM_COUNT_HELLENISTIC" }
					}

					hbox_LR_tsm_legend_row = {
						blockoverride "swatch_color" { color = { 0.53 0.16 0.51 1 } }
						blockoverride "group_name" { text = "LR_title_set_map_sub_region_LR_tsm_roman" }
						blockoverride "count" { text = "LR_TSM_COUNT_ROMAN" }
					}

					hbox_LR_tsm_legend_row = {
						blockoverride "swatch_color" { color = { 0.88 0.69 0.18 1 } }
						blockoverride "group_name" { text = "LR_title_set_map_sub_region_LR_tsm_themes" }
						blockoverride "count" { text = "LR_TSM_COUNT_THEMES" }
					}

					hbox_LR_tsm_legend_row = {
						blockoverride "swatch_color" { color = { 0.16 0.57 0.29 1 } }
						blockoverride "group_name" { text = "LR_title_set_map_sub_region_LR_tsm_persian" }
						blockoverride "count" { text = "LR_TSM_COUNT_PERSIAN" }
					}

					hbox_LR_tsm_legend_row = {
						blockoverride "swatch_color" { color = { 0.31 0.76 0.82 1 } }
						blockoverride "group_name" { text = "LR_title_set_map_sub_region_LR_tsm_hebrew" }
						blockoverride "count" { text = "LR_TSM_COUNT_HEBREW" }
					}

					hbox_LR_tsm_legend_row = {
						visible = "[Not( GetScriptedGui( 'LR_tsm_view_rule' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
						blockoverride "swatch_color" { color = { 0.82 0.1 0.14 1 } }
						blockoverride "group_name" { text = "LR_title_set_map_sub_region_LR_tsm_foreign" }
						blockoverride "count" { text = "LR_TSM_COUNT_FOREIGN" }
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 10

						icon = {
							size = { 22 22 }
							texture = "gfx/interface/colors/white.dds"
							color = { 0.5 0.5 0.5 1 }
						}

						text_single = {
							text = "LR_TSM_LEGEND_OTHERS"
							default_format = "#weak"
							align = nobaseline
						}

						expand = {}
					}
				}

				### Map modes & participants ###
				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 15 10 }
					spacing = 10

					background = {
						using = Background_Area
					}

					text_single = {
						text = "TMM_MAP_MODES"
						align = nobaseline
					}

					icon_button_mapmode = {
						size = { 36 36 }
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'situation' )]"
						}
					}

					icon_button_mapmode = {
						size = { 36 36 }
						blockoverride "mm_datacontext"
						{
							datacontext = "[GetMapMode( 'realms' )]"
						}
					}

					expand = {}

					button_standard_small = {
						onclick = "[SituationWindow.AccessParticipantCharacterList.Toggle]"
						text = "LR_TSM_VIEW_PARTICIPANTS"
					}
				}

				expand = {}
			}
		}
	}

	window_situation_participant_groups = {
		datacontext = "[SituationWindow.AccessParticipantCharacterList]"
		datacontext = "[SituationParticipantCharacterList.AccessCharacterList]"
		visible = "[SituationParticipantCharacterList.IsVisible]"

		datacontext = "[SituationWindow.GetSelectedSubRegion]"
		blockoverride "header_text"
		{
			text = "[SituationWindow.GetParticipationWindowHeader]"
		}
	}
}

types LRTitleSetMap
{
	# One legend line: map colour, name, number of counties (variables set by LR_tsm_refresh_effect)
	type hbox_LR_tsm_legend_row = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 10

		icon = {
			size = { 22 22 }
			texture = "gfx/interface/colors/white.dds"
			block "swatch_color" {}
		}

		text_single = {
			block "group_name" {}
			align = nobaseline
		}

		expand = {}

		text_single = {
			block "count" {}
			align = nobaseline
		}
	}

	# A view button: disabled while it is the current view
	type button_LR_tsm_view = button_standard_small {
		size = { 140 30 }
		using = tooltip_ne
	}
}
