key = {
	icon = "icon" # Uses key name as default

	hud_text = "LOC_KEY" # The (very tiny) text that will be shown in the scheme HUD widget after this pulse action fires.

	### Scopes for all the script
	# root = the scheme
	# scope:scheme = the scheme
	# scope:owner = owner of the scheme
	# scope:target = target of the scheme (scope:target_title as well for title schemes)
	# scope:artifact = the artifact used for the scheme, if any

	# Can this action be picked on the pulse (re-checked right before the effect is run)
	is_valid = {
		<triggers>
	}

	# Relative weight of this action being against all others
	weight = {
		<script value>
	}

	# Effect run when this action is picked, after the scheme type's on_phase_completed
	effect = {
		<effects>
	}
}
