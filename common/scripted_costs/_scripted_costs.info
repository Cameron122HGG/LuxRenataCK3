### Brief: key ( database key )
# Name of 'scripted_cost'
# Named costs looked up by code for specific features. Only the keys listed below are used; each one is
# required and an error is logged if it is missing.
#
# The same block syntax ( <scripted_cost> ) is used by cost fields in other databases, e.g. cost = { ... },
# pass_cost = { ... }, piety_cost = { ... }. Those blocks are defined inline and can't refer to an entry in this folder.
#
key = {
	### Brief: gold ( optional script value )
	# Gold cost.
	#
	gold = <script value>

	### Brief: prestige ( optional script value )
	# Prestige cost.
	#
	prestige = <script value>

	### Brief: piety ( optional script value )
	# Piety cost.
	#
	piety = <script value>

	### Brief: renown ( optional script value )
	# Renown ( dynasty prestige ) cost. Can only be paid by a dynast; non-dynasts can't afford a non-zero renown cost.
	#
	renown = <script value>

	### Brief: influence ( optional script value )
	# Influence cost.
	#
	influence = <script value>

	### Brief: herd ( optional script value )
	# Herd cost, taken from the character's domicile. Only applied to characters that use herd.
	#
	herd = <script value>

	### Brief: treasury ( optional script value )
	# Treasury cost.
	#
	treasury = <script value>

	### Brief: treasury_or_gold ( optional script value )
	# Paid from treasury if the character's government has the replace_gold_cost_by_treasury rule and the character
	# has a treasury, otherwise paid from gold. Shown as a treasury or gold cost accordingly.
	#
	treasury_or_gold = <script value>

	### Brief: merit ( optional script value )
	# Merit cost.
	#
	merit = <script value>

	### Brief: barter_goods ( optional script value )
	# Barter goods cost.
	#
	barter_goods = <script value>

	### Brief: round ( optional bool )
	# Round each calculated cost to the nearest integer.
	# Default: yes
	#
	round = yes

	### Brief: clamp_to_zero ( optional bool )
	# Clamp each calculated cost to 0 or more.
	# Default: yes
	#
	clamp_to_zero = yes
}

# Notes on <scripted_cost> blocks:
# - Unset currencies cost 0. A cost of 0 is always affordable.
# - Clamping happens before rounding.
# - Script value desc/format entries are used for the cost breakdown tooltips.
# - Scopes are set up by the database or feature that owns the cost field; see the respective .info file.

