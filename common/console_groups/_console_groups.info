### Brief: key ( database key )
# Name of 'console_group'
# A named group of console commands and shortcuts in the console menu. The key is used as the group name.
# Console commands not listed in any group are grouped automatically: commands named "<prefix>.<name>"
# go in the group <prefix>, all others go in the group "Other".
#
key = {
	### Brief: entries ( list of strings )
	# Unnamed list of strings. Each entry is either:
	#	a console command name: that command is put in this group. Must match a registered command name
	#		exactly (case sensitive), otherwise it asserts.
	#	"<name> <command line>": an entry containing a space becomes a shortcut named <name> (the text before
	#		the first space) that runs <command line> (everything after the first space, arguments included).
	#
	command_name
	"ShortcutName command argument"
}
